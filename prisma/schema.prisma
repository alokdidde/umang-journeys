generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ABANDONED
}

enum NodeStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  WAITING_EXTERNAL
  COMPLETED
  BLOCKED
  SKIPPED
}

enum SourceType {
  USER_STATEMENT
  DERIVED
  DEMO_PROFILE
  MOCK_HOSPITAL
  USER_CONFIRMED
}

enum ExternalActionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum JourneySubjectType {
  CHILD
  VEHICLE
}

model UserProfile {
  id          String            @id @default(cuid())
  sessionId   String            @unique
  displayName String
  locale      String            @default("en-IN")
  stateCode   String
  demoProfile Boolean           @default(true)
  journeys    JourneyInstance[]
  subjects    JourneySubject[]
  documentIntakes DocumentIntake[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model JourneySubject {
  id          String             @id @default(cuid())
  profileId   String
  type        JourneySubjectType
  displayName String
  dateOfBirth DateTime?
  profile     UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journeys    JourneyInstance[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model JourneyTemplate {
  id         String            @id
  version    Int
  lifeEvent  String
  status     String            @default("active")
  configJson Json
  journeys   JourneyInstance[]
}

model JourneyInstance {
  id              String           @id @default(cuid())
  profileId       String
  templateId      String
  templateVersion Int
  subjectId       String
  status          JourneyStatus    @default(DRAFT)
  startedAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         UserProfile      @relation(fields: [profileId], references: [id])
  template        JourneyTemplate  @relation(fields: [templateId], references: [id])
  subject         JourneySubject   @relation(fields: [subjectId], references: [id])
  nodes           JourneyNode[]
  edges           JourneyEdge[]
  facts           Fact[]
  evidence        Evidence[]
  documents       OutputDocument[]
  audits          AuditEvent[]
  documentIntakes DocumentIntake[]
}

model DocumentIntake {
  id               String           @id @default(cuid())
  profileId        String
  journeyId        String?
  status           String           @default("proposed")
  fileName         String
  mimeType         String
  size             Int
  source           String
  documentType     String
  confidence       Float
  contentBase64    String
  analysisJson     Json
  proposalJson     Json
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journey          JourneyInstance? @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([profileId, createdAt])
}

model JourneyNode {
  id          String           @id @default(cuid())
  journeyId   String
  nodeKey     String
  status      NodeStatus
  recommended Boolean          @default(false)
  completedAt DateTime?
  journey     JourneyInstance  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  actions     ExternalAction[]
  documents   OutputDocument[]

  @@unique([journeyId, nodeKey])
}

model JourneyEdge {
  id          String          @id @default(cuid())
  journeyId   String
  fromNodeKey String
  toNodeKey   String
  edgeType    String          @default("hard")
  journey     JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model Fact {
  id         String          @id @default(cuid())
  journeyId  String
  key        String
  valueJson  Json
  confidence Float?
  sourceType SourceType
  sourceRef  String?
  confirmed  Boolean         @default(false)
  journey    JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, key])
}

model Evidence {
  id           String          @id @default(cuid())
  journeyId    String
  type         String
  provider     String
  metadataJson Json
  journey      JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model ExternalAction {
  id             String               @id @default(cuid())
  nodeId         String
  adapterKey     String
  actionType     String
  status         ExternalActionStatus
  idempotencyKey String               @unique
  requestJson    Json
  responseJson   Json?
  createdAt      DateTime             @default(now())
  node           JourneyNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model OutputDocument {
  id           String          @id @default(cuid())
  journeyId    String
  nodeId       String
  type         String
  synthetic    Boolean         @default(true)
  metadataJson Json
  journey      JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  node         JourneyNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String          @id @default(cuid())
  journeyId   String
  actorType   String
  eventType   String
  payloadJson Json
  createdAt   DateTime        @default(now())
  journey     JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}
