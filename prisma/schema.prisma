generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ABANDONED
}

enum NodeStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  WAITING_EXTERNAL
  COMPLETED
  BLOCKED
  SKIPPED
}

enum SourceType {
  USER_STATEMENT
  DERIVED
  DEMO_PROFILE
  MOCK_HOSPITAL
  USER_CONFIRMED
}

enum ExternalActionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CanonicalEntityType {
  PERSON
  HOUSEHOLD
  ADDRESS
  VEHICLE
  BUSINESS
  POLICY
  ACCOUNT
}

enum FactRevisionStatus {
  ACTIVE
  CORRECTED
  RETRACTED
}

enum ProviderCaseStatus {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
  APPEALED
}

enum CitizenTaskStatus {
  OPEN
  WAITING
  COMPLETED
  DISMISSED
}

enum JourneySubjectType {
  CHILD
  VEHICLE
  PERSON
  RESIDENCE
  BUSINESS
}

model UserProfile {
  id          String            @id @default(cuid())
  sessionId   String            @unique
  displayName String
  locale      String            @default("en-IN")
  stateCode   String
  demoProfile Boolean           @default(true)
  journeys    JourneyInstance[]
  subjects    JourneySubject[]
  documentIntakes DocumentIntake[]
  entities     CanonicalEntity[]
  tasks        CitizenTask[]
  consents     ConsentGrant[]
  accessEvents AccessEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CanonicalEntity {
  id          String              @id @default(cuid())
  profileId   String
  type        CanonicalEntityType
  displayName String
  externalKey String?
  dataJson    Json
  profile     UserProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journeyLinks JourneyEntityLink[]
  outgoingRelationships EntityRelationship[] @relation("RelationshipFrom")
  incomingRelationships EntityRelationship[] @relation("RelationshipTo")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([profileId, type])
  @@unique([profileId, type, externalKey])
}

model EntityRelationship {
  id        String          @id @default(cuid())
  fromId    String
  toId      String
  kind      String
  validFrom DateTime?
  validTo   DateTime?
  from      CanonicalEntity @relation("RelationshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        CanonicalEntity @relation("RelationshipTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

model JourneySubject {
  id          String             @id @default(cuid())
  profileId   String
  type        JourneySubjectType
  displayName String
  dateOfBirth DateTime?
  profile     UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journeys    JourneyInstance[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model JourneyTemplate {
  id         String            @id
  version    Int
  lifeEvent  String
  status     String            @default("active")
  configJson Json
  journeys   JourneyInstance[]
}

model JourneyInstance {
  id              String           @id @default(cuid())
  profileId       String
  templateId      String
  templateVersion Int
  subjectId       String
  status          JourneyStatus    @default(DRAFT)
  startedAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         UserProfile      @relation(fields: [profileId], references: [id])
  template        JourneyTemplate  @relation(fields: [templateId], references: [id])
  subject         JourneySubject   @relation(fields: [subjectId], references: [id])
  nodes           JourneyNode[]
  edges           JourneyEdge[]
  facts           Fact[]
  evidence        Evidence[]
  documents       OutputDocument[]
  audits          AuditEvent[]
  documentIntakes DocumentIntake[]
  entityLinks     JourneyEntityLink[]
  tasks           CitizenTask[]
  providerCases   ProviderCase[]
  templateSnapshot JourneyTemplateVersion? @relation(fields: [templateId, templateVersion], references: [templateKey, version])
}

model JourneyEntityLink {
  id        String          @id @default(cuid())
  journeyId String
  entityId  String
  role      String
  journey   JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  entity    CanonicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([journeyId, entityId, role])
}

model JourneyTemplateVersion {
  id          String            @id @default(cuid())
  templateKey String
  version     Int
  lifeEvent   String
  configJson  Json
  createdAt   DateTime          @default(now())
  journeys    JourneyInstance[]

  @@unique([templateKey, version])
}

model DocumentIntake {
  id               String           @id @default(cuid())
  profileId        String
  journeyId        String?
  status           String           @default("proposed")
  fileName         String
  mimeType         String
  size             Int
  source           String
  documentType     String
  confidence       Float
  contentBase64    String
  analysisJson     Json
  proposalJson     Json
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journey          JourneyInstance? @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([profileId, createdAt])
}

model JourneyNode {
  id          String           @id @default(cuid())
  journeyId   String
  nodeKey     String
  status      NodeStatus
  recommended Boolean          @default(false)
  completedAt DateTime?
  journey     JourneyInstance  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  actions     ExternalAction[]
  documents   OutputDocument[]

  @@unique([journeyId, nodeKey])
}

model JourneyEdge {
  id          String          @id @default(cuid())
  journeyId   String
  fromNodeKey String
  toNodeKey   String
  edgeType    String          @default("hard")
  journey     JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model Fact {
  id         String          @id @default(cuid())
  journeyId  String
  key        String
  valueJson  Json
  confidence Float?
  sourceType SourceType
  sourceRef  String?
  confirmed  Boolean         @default(false)
  journey    JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  revisions  FactRevision[]

  @@unique([journeyId, key])
}

model FactRevision {
  id           String             @id @default(cuid())
  factId       String
  valueJson    Json
  sourceType   SourceType
  sourceRef    String?
  confidence   Float?
  status       FactRevisionStatus @default(ACTIVE)
  supersedesId String?
  fact         Fact               @relation(fields: [factId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@index([factId, createdAt])
}

model Evidence {
  id           String          @id @default(cuid())
  journeyId    String
  type         String
  provider     String
  metadataJson Json
  journey      JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model ExternalAction {
  id             String               @id @default(cuid())
  nodeId         String
  adapterKey     String
  actionType     String
  status         ExternalActionStatus
  idempotencyKey String               @unique
  requestJson    Json
  responseJson   Json?
  createdAt      DateTime             @default(now())
  node           JourneyNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model ProviderCase {
  id               String             @id @default(cuid())
  journeyId        String
  nodeKey          String
  provider         String
  status           ProviderCaseStatus
  scenario         String
  reasonCode       String?
  nextTransitionAt DateTime?
  payloadJson      Json
  journey          JourneyInstance    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([journeyId, nodeKey])
}

model CitizenTask {
  id          String            @id @default(cuid())
  profileId   String
  journeyId   String?
  kind        String
  title       String
  detail      String
  status      CitizenTaskStatus @default(OPEN)
  dueAt       DateTime?
  reminderAt  DateTime?
  metadataJson Json
  profile     UserProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journey     JourneyInstance?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([profileId, status, dueAt])
}

model ConsentGrant {
  id          String      @id @default(cuid())
  profileId   String
  purpose     String
  scopeJson   Json
  grantedAt   DateTime    @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AccessEvent {
  id          String      @id @default(cuid())
  profileId   String
  actor       String
  action      String
  resourceType String
  resourceId  String
  metadataJson Json
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([profileId, createdAt])
}

model OutputDocument {
  id           String          @id @default(cuid())
  journeyId    String
  nodeId       String
  type         String
  synthetic    Boolean         @default(true)
  metadataJson Json
  version      Int             @default(1)
  supersedesId String?
  checksum     String?
  journey      JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  node         JourneyNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String          @id @default(cuid())
  journeyId   String
  actorType   String
  eventType   String
  payloadJson Json
  createdAt   DateTime        @default(now())
  journey     JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}
